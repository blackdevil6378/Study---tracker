# STUDY TRACKER Environment Variables (Optional)
# Note: You can enter and test your Gemini and YouTube Data API keys directly in the Settings page UI.
# In the browser, your keys are stored in localStorage and sent per-request in custom request headers.
# If you prefer to provide server-level defaults, you may set them below:

NEXT_PUBLIC_APP_NAME="Study Tracker"
# Supabase project settings for email sign-in and cloud data sync:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# GEMINI_API_KEY=your_gemini_api_key_here
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# GitHub Personal Access Token for feedback → GitHub Issues integration
# Create one at: https://github.com/settings/tokens → Fine-grained → repo:issues (write) permission
GITHUB_FEEDBACK_TOKEN=your_github_personal_access_token_here
